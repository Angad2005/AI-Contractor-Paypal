# NVIDIA NIM configuration only.
# Create an API key for an account that has access to the model you select.
# Keep the key private; never commit a populated .env file.
LLM_PROVIDER=nvidia-nim
LLM_API_KEY=your_nvidia_nim_api_key
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
