APP_ENV=development
DATABASE_URL=sqlite:///./app.db
GENERATED_DIR=generated

# Use mock for local tests or sandbox for the real PayPal Developer Sandbox API.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8000/api/paypal/return
PAYPAL_CANCEL_URL=http://localhost:8000/api/paypal/cancel

# Use demo for deterministic local fallback or openai-compatible for real AI.
LLM_PROVIDER=nvidia-nim
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_SECONDS=300


# Settings page protection (required for production deployment)
# Generate these with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ADMIN_TOKEN=
SETTINGS_ENCRYPTION_KEY=
