APP_ENV=development
DATABASE_URL=sqlite:///./app.db
GENERATED_DIR=generated

# Use mock for local tests or sandbox for the real PayPal Developer Sandbox API.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:8000/api/paypal/return
PAYPAL_CANCEL_URL=http://localhost:8000/api/paypal/cancel

# NVIDIA NIM uses an OpenAI-compatible chat-completions API. For LM Studio,
# see the local setup instructions in README.md (no API key is needed by default).
LLM_PROVIDER=nvidia-nim
LLM_API_KEY=
LLM_MODEL=your-nvidia-nim-model-id
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# LM Studio alternative (start its local API server on port 1234 first):
# LLM_PROVIDER=lm-studio
# LLM_API_KEY=
# LLM_MODEL=your-loaded-lm-studio-model-id
# LLM_BASE_URL=http://localhost:1234/v1

# Settings page protection (required for production deployment)
# Generate these with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ADMIN_TOKEN=
SETTINGS_ENCRYPTION_KEY=
